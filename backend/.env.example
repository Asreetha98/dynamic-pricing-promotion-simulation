# SQLite is the quickest option for local testing.
DATABASE_URL=sqlite:///./pricing_simulation.db
API_PREFIX=/api
RANDOM_SEED=20261022
# Replace this with a long, random secret before sharing/deployment.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

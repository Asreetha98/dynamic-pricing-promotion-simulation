{
  "products": {
    "product_id": "VARCHAR(20), required PK",
    "sku": "VARCHAR(20), required unique; SKU-000001",
    "base_price": "NUMERIC(12,2), INR, >0",
    "price_floor": "NUMERIC(12,2), INR, >0 and <= base_price",
